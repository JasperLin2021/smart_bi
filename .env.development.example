# Copy this file to .env.development for the Docker Compose development stack.
# Values here are intentionally local-only and should not be reused in production.

COMPOSE_PROJECT_NAME=smart_bi_dev

POSTGRES_DB=smart_bi_dev
POSTGRES_USER=smart_bi
POSTGRES_PASSWORD=smart_bi_dev_password
DATABASE_URL=postgresql+psycopg2://smart_bi:smart_bi_dev_password@postgres:5432/smart_bi_dev

JWT_SECRET=dev_only_replace_if_shared
ACCESS_TOKEN_EXPIRE_MINUTES=480

LLM_PROVIDER=custom
LLM_API_BASE=http://host.docker.internal:8001/v1
LLM_API_KEY=change_me_for_local_llm
LLM_MODEL=gpt-4o-mini
LLM_PI_BASE=http://host.docker.internal:8001/v1
LLM_PI_KEY=change_me_for_local_llm
LLM_PI_MODEL=pi/pi-mono
LLM_DASHSCOPE_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DASHSCOPE_KEY=change_me_for_dashscope
LLM_DASHSCOPE_MODEL=qwen3.6-35b-a3b

CUBE_API_URL=http://host.docker.internal:4000/cubejs-api/v1
CUBE_API_TOKEN=change_me

DORIS_ENABLED=false
DORIS_HOST=doris-fe
DORIS_QUERY_PORT=9030
DORIS_HTTP_PORT=8030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=smart_bi_olap
DORIS_MATERIALIZATION_LIMIT=100000

GOVIEW_ENABLED=false
GOVIEW_BASE_URL=http://host.docker.internal:3000
GOVIEW_EMBED_BASE_URL=http://host.docker.internal:3000
GOVIEW_VIEW_PATH=/#/project/items
GOVIEW_DESIGN_PATH=/#/project/items
GOVIEW_BRIDGE_SECRET=dev_only_goview_secret

FRONTEND_DEV_PORT=16006
BACKEND_PORT=8002
POSTGRES_PORT=15432
