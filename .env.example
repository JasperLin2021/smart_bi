# Copy this file to .env before running docker compose.
# Replace all change_me values before exposing the service publicly.

POSTGRES_DB=smart_bi
POSTGRES_USER=smart_bi
POSTGRES_PASSWORD=change_me_strong_database_password

DATABASE_URL=postgresql+psycopg2://smart_bi:change_me_strong_database_password@postgres:5432/smart_bi
JWT_SECRET=change_me_to_a_long_random_secret

LLM_PROVIDER=custom
LLM_API_BASE=http://host.docker.internal:8001/v1
LLM_API_KEY=change_me
LLM_MODEL=gpt-4o-mini

CUBE_API_URL=http://host.docker.internal:4000/cubejs-api/v1
CUBE_API_TOKEN=change_me

# Host port for the production frontend container.
FRONTEND_PORT=16006
