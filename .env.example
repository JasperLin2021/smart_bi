# Copy this file to .env for the default quick-preview Docker Compose stack.
# For active development use .env.development.example and docker-compose.dev.yml.
# For production use .env.production.example and docker-compose.prod.yml.
# Replace all change_me values before exposing the service publicly.

POSTGRES_DB=smart_bi
POSTGRES_USER=smart_bi
POSTGRES_PASSWORD=change_me_strong_database_password

DATABASE_URL=postgresql+psycopg2://smart_bi:change_me_strong_database_password@postgres:5432/smart_bi
JWT_SECRET=change_me_to_a_long_random_secret

LLM_PROVIDER=custom
LLM_API_BASE=http://host.docker.internal:8001/v1
LLM_API_KEY=change_me
LLM_MODEL=gpt-4o-mini
LLM_DASHSCOPE_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DASHSCOPE_KEY=change_me
LLM_DASHSCOPE_MODEL=qwen3.6-35b-a3b

CUBE_API_URL=http://host.docker.internal:4000/cubejs-api/v1
CUBE_API_TOKEN=change_me

# Optional Apache Doris OLAP acceleration.
# Start local Doris with: docker compose --profile olap up -d
DORIS_ENABLED=false
DORIS_HOST=doris-fe
DORIS_QUERY_PORT=9030
DORIS_HTTP_PORT=8030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=smart_bi_olap
DORIS_MATERIALIZATION_LIMIT=100000
DORIS_BE_WEB_PORT=8040
DORIS_BE_HEARTBEAT_PORT=9050

GOVIEW_ENABLED=true
GOVIEW_BASE_URL=http://host.docker.internal:3000
GOVIEW_EMBED_BASE_URL=http://host.docker.internal:3000
GOVIEW_VIEW_PATH=/#/project/items
GOVIEW_DESIGN_PATH=/#/project/items
GOVIEW_BRIDGE_SECRET=change_me_to_a_long_random_secret

# Enterprise WeChat login is configured in the app:
# System Management -> 企业微信集成.
# Store CorpID, AgentID, Secret, callback URL, org binding, and department
# permission mappings there so secrets are kept in the application database.

# Host port for the production frontend container.
FRONTEND_PORT=16006
