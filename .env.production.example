# Copy this file to .env.production before deploying with docker-compose.prod.yml.
# Replace every replace_me value before exposing the service.

COMPOSE_PROJECT_NAME=smart_bi_prod

POSTGRES_DB=smart_bi
POSTGRES_USER=smart_bi
POSTGRES_PASSWORD=replace_me_with_a_strong_database_password
DATABASE_URL=postgresql+psycopg2://smart_bi:replace_me_with_a_strong_database_password@postgres:5432/smart_bi

JWT_SECRET=replace_me_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=480

LLM_PROVIDER=custom
LLM_API_BASE=https://llm-gateway.example.com/v1
LLM_API_KEY=replace_me_with_production_llm_key
LLM_MODEL=gpt-4o-mini
LLM_PI_BASE=https://llm-gateway.example.com/v1
LLM_PI_KEY=replace_me_with_production_pi_key
LLM_PI_MODEL=pi/pi-mono
LLM_DASHSCOPE_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DASHSCOPE_KEY=replace_me_with_dashscope_key
LLM_DASHSCOPE_MODEL=qwen3.6-35b-a3b
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=120

CUBE_API_URL=http://cube:4000/cubejs-api/v1
CUBE_API_TOKEN=replace_me_if_cube_is_enabled

DORIS_ENABLED=false
DORIS_HOST=doris-fe
DORIS_QUERY_PORT=9030
DORIS_HTTP_PORT=8030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=smart_bi_olap
DORIS_MATERIALIZATION_LIMIT=100000
DORIS_BE_WEB_PORT=8040
DORIS_BE_HEARTBEAT_PORT=9050

GOVIEW_ENABLED=false
GOVIEW_BASE_URL=https://goview.example.com
GOVIEW_EMBED_BASE_URL=https://goview.example.com
GOVIEW_VIEW_PATH=/#/project/items
GOVIEW_DESIGN_PATH=/#/project/items
GOVIEW_BRIDGE_SECRET=replace_me_with_a_long_random_secret

FRONTEND_PORT=16006
